{
    "name": "matthiggins/bluezone",
    "description": "A modern PHP SDK for the PUBG API and PUBG match telemetry files.",
    "keywords": ["pubg", "pubg-api", "saloon", "sdk"],
    "homepage": "https://github.com/matthiggins/bluezone",
    "license": "MIT",
    "authors": [{ "name": "Matt Higgins", "email": "github@creativestasis.com", "role": "Developer" }],
    "require": {
        "php": "^8.3",
        "illuminate/collections": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.0",
        "saloonphp/rate-limit-plugin": "^2.5",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": { "psr-4": { "Bluezone\\": "src" } },
    "autoload-dev": { "psr-4": { "Bluezone\\Tests\\": "tests" } },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "check": ["vendor/bin/pint --test", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true, "phpstan/extension-installer": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
